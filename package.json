{
  "name": "sepay-payment-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Demo luồng thanh toán chuyển khoản qua SePay (Webhook + API v2, Test mode)",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "predev": "npm run build:web",
    "dev": "tsx watch src/server.ts",
    "dev:web": "tsc -p tsconfig.web.json --watch",
    "prestart": "npm run build:web",
    "start": "tsx src/server.ts",
    "build:web": "tsc -p tsconfig.web.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "tsx scripts/smoke.ts",
    "webhook": "tsx scripts/send-webhook.ts"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
