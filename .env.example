# ─────────────────────────────────────────────────────────────
# Demo SePay (Node.js + TypeScript) — copy sang `.env` rồi sửa:
#   npm run dev                                        (dùng env hiện tại)
#   npx tsx --env-file=.env src/server.ts              (Node 22.18+: node --env-file=.env src/server.ts)
# ─────────────────────────────────────────────────────────────

# mock    = tự giả lập sandbox trong process (mặc định, không cần token)
# sandbox = gọi thật userapi-sandbox.sepay.vn (token Test mode)
# live    = gọi thật userapi.sepay.vn (CẨN THẬN: tiền thật)
SEPAY_MODE=mock

# Token tạo tại my.sepay.vn → Test mode → API Access → + Thêm API.
# Token Test mode CHỈ chạy được trên userapi-sandbox, không dùng chung với Live.
SEPAY_API_TOKEN=

# sandbox | live: UUID tài khoản ngân hàng (ba_xid) — lấy từ GET /v2/bank-accounts
SEPAY_BANK_ACCOUNT_ID=
# Vietcombank bắt buộc tid = Terminal ID GỐC (vd 20933557), KHÔNG phải UUID SePay
SEPAY_VCB_TID=
# Sacombank bắt buộc va_prefix (vd SEP200001WEB)
SEPAY_SACOMBANK_VA_PREFIX=

SEPAY_WITH_QRCODE=1
SEPAY_QRCODE_TEMPLATE=compact
SEPAY_VA_DURATION=900

# ── Webhook (đăng ký tại Test mode → Tích hợp Webhook → Thêm webhook) ──
# hmac | apikey | none   (hmac là khuyến nghị của SePay)
SEPAY_WEBHOOK_AUTH=hmac
# Phải giống hệt Secret Key nhập ở bước "Bảo mật" khi tạo webhook
SEPAY_WEBHOOK_SECRET=doi-key-nay-trong-production
# Chỉ dùng khi SEPAY_WEBHOOK_AUTH=apikey → Authorization: Apikey <KEY>
SEPAY_WEBHOOK_API_KEY=
SEPAY_WEBHOOK_TOLERANCE=300

# URL công khai để SePay gọi vào (tunnel ngrok/cloudflare khi test webhook thật)
PUBLIC_URL=

# ── Bộ lọc webhook, mô phỏng đúng cấu hình trên dashboard ──
SEPAY_WEBHOOK_EVENT_TYPE=in
SEPAY_WEBHOOK_ONLY_WITH_CODE=true
# phân cách bằng dấu phẩy, để trống = nhận mọi tiền tố
SEPAY_WEBHOOK_CODE_PREFIXES=
SEPAY_WEBHOOK_VA_ONLY=false

# ── Đơn hàng ──
# Công ty → Cấu hình chung → Cấu trúc mã thanh toán (demo dùng tiền tố DH)
ORDER_CODE_PREFIX=DH
ORDER_TTL_SEC=900
# Sacombank/Vietcombank/Shinhan chỉ nhận ĐÚNG số tiền; VietinBank chấp nhận trả thiếu
ALLOW_PARTIAL_PAYMENT=false

# ── Bộ mô phỏng (chỉ dùng khi SEPAY_MODE=mock) ──
SIM_DAILY_QUOTA=500
# SePay retry 7 lần theo Fibonacci 1,1,2,3,5,8,13 phút (~33 phút).
# Demo nén: 1 phút = 2 giây. Đặt 0 = không retry.
SIM_RETRY_UNIT_SEC=2
